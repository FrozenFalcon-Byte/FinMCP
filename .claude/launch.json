{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "progress",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "-d", "progress"],
      "port": 8765
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    }
  ]
}
