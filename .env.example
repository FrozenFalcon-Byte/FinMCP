# ---------------------------------------------------------------------------
# FinMCP configuration. Copy to .env and fill in what you use. Everything is optional:
# with nothing set, FinMCP runs fully local (embedded PostgreSQL under data/, local accounts).
# ---------------------------------------------------------------------------

# --- Supabase (free tier is enough) -----------------------------------------
# Project settings -> API. The anon/publishable key is safe to expose to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project settings -> Database -> Connection string (URI). Use the "Session" pooler URL (port 5432)
# or the direct connection; the "Transaction" pooler (6543) also works.
SUPABASE_DB_URL=
# Only if your project still uses the legacy HS256 "JWT secret" (Project settings -> JWT). Projects on the
# newer asymmetric signing keys need nothing here: tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=
# Optional: lets "Delete my account" remove the Supabase Auth user too. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: OAuth providers you enabled under Authentication -> Providers, comma separated (google,github).
SUPABASE_OAUTH_PROVIDERS=

# --- Claude -----------------------------------------------------------------
# Without a key every feature still works on the deterministic offline engine.
ANTHROPIC_API_KEY=
FINMCP_MODEL=claude-opus-5
FINMCP_LLM=auto            # auto | anthropic | rules
FINMCP_AGENT_DRIVER=auto   # auto | anthropic | local
FINMCP_AGENT_EFFORT=medium

# --- App ---------------------------------------------------------------------
# Where the API is reachable; used in the MCP config snippets shown under Connect.
FINMCP_PUBLIC_URL=http://127.0.0.1:8000
FINMCP_CURRENCY=INR
# Local mode only: signing secret for session tokens (auto-generated into data/.jwt-secret when unset).
FINMCP_JWT_SECRET=
# Local mode only: port of the embedded PostgreSQL cluster.
FINMCP_PG_PORT=54329
# Use an existing PostgreSQL instead of the embedded one (also overrides SUPABASE_DB_URL).
FINMCP_DATABASE_URL=
