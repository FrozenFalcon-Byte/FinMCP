# Copy to .env and fill in. Never commit .env.

# Required for LLM-backed features (categorization, text-to-SQL, vision OCR, the agent).
# Without it the server runs in deterministic fallback mode.
ANTHROPIC_API_KEY=

# Model used by the server-side categorizer / text-to-SQL and by the agent.
FINMCP_MODEL=claude-opus-5

# SQLite path (default: data/finmcp.db). Use :memory: for throwaway sessions.
FINMCP_DB=data/finmcp.db

# Currency shown in summaries.
FINMCP_CURRENCY=INR

# Backend API
FINMCP_API_HOST=127.0.0.1
FINMCP_API_PORT=8000
